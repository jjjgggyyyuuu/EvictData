## Versioning

### Version Control
```typescript
interface VersionConfig {
  current: 'v1';
  supported: ['v1'];
  deprecated: [];
  sunset: {
    'v1': null
  };
}

const versionMiddleware = (req: Request, res: Response, next: NextFunction) => {
  const version = req.headers['api-version'] || 'v1';
  if (!config.supported.includes(version)) {
    return next(new APIError('Unsupported API version', 400, 'VERSION_ERROR'));
  }
  next();
};
```

## Performance

### Compression
```typescript
const compressionConfig = {
  level: 6,
  threshold: 1024, // bytes
  filter: (req: Request, res: Response) => {
    if (req.headers['x-no-compression']) {
      return false;
    }
    return compression.filter(req, res);
  }
};
```

### Request Timeout
```typescript
const timeoutConfig = {
  // Global timeout
  server: {
    timeout: 30000 // 30 seconds
  },
  
  // Route-specific timeouts
  routes: {
    'POST /api/documents/upload': 120000, // 2 minutes
    'GET /api/reports/generate': 60000 // 1 minute
  }
};
```

